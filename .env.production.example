# ==============================================================================
# Terma Production Environment Configuration (.env.production)
# ==============================================================================

# Primary Domain (e.g. terma.ir or shop.terma.ir)
PROD_DOMAIN=terma.ir

# Image tag (populated dynamically by GitHub Actions with commit SHA)
PROD_IMAGE_TAG=latest

# Master Database SA Password (used strictly for backups & admin maintenance)
DB_SA_PASSWORD=ReplaceWithStrongSaPassword_2026!#

# Production Database User Password (used by Production API connection string)
PROD_DB_PASSWORD=ReplaceWithStrongProdDbPassword_2026!#

# Cryptographic OTP challenge hash key (minimum 32 characters, high entropy)
PROD_OTP_HASH_KEY=ReplaceWithProdOtpHashKey_Minimum32Chars_Secure!#

# Production SMS.ir Gateway Credentials
PROD_SMSIR_ENABLED=true
PROD_SMSIR_API_KEY=your_production_smsir_api_key_here
PROD_SMSIR_TEMPLATE_ID=123456

# Production Telegram Order Notifications (Optional)
PROD_TELEGRAM_ENABLED=false
PROD_TELEGRAM_BOT_TOKEN=
PROD_TELEGRAM_ADMIN_CHAT_ID=

# Production ZarinPal Payment Gateway
PROD_ZARINPAL_IS_SANDBOX=false
PROD_ZARINPAL_MERCHANT_ID=your_production_zarinpal_merchant_id_here

# Off-site Backup Cloud Storage (S3 / ArvanCloud / Cloudflare R2 / MinIO)
OFFSITE_BACKUP_ENABLED=false
S3_BUCKET_NAME=terma-database-backups
S3_ENDPOINT_URL=https://s3.ir-tbz-sh1.arvanstorage.ir
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=ReplaceWithStrongBackupEncryptionKey!#
