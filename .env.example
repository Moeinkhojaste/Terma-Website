# ==============================================================================
# Terma Environment Configuration Reference
# ==============================================================================
# For Production deployments, copy .env.production.example to .env.production
# For Staging deployments, copy .env.staging.example to .env.staging
# For Local Development, configure the parameters below.

# Host / Domain
SERVER_HOST=localhost

# Database Master Password (SQL Server SA)
DB_PASSWORD=TermaLocalDev_DbPassword_2026!#Strong

# Application OTP Secret Key (at least 32 characters)
OTP_HASH_KEY=TermaLocalDev_OtpSecretKey_9876543210_Secure!

# Security & Features
REQUIRE_SECURE_COOKIES=false
ENFORCE_HTTPS=false
ENABLE_SWAGGER=true
OTP_EXPOSE_CODE=true
