# ==============================================================================
# Terma Staging Environment Configuration (.env.staging)
# ==============================================================================

# Staging Domain (e.g. staging.terma.ir)
STAGING_DOMAIN=staging.terma.ir

# Image tag (populated dynamically by GitHub Actions with commit SHA)
STAGING_IMAGE_TAG=staging

# Master Database SA Password (shared engine maintenance)
DB_SA_PASSWORD=ReplaceWithStrongSaPassword_2026!#

# Staging Database User Password (strictly isolated to TermaDb_Staging)
STAGING_DB_PASSWORD=ReplaceWithStrongStagingDbPassword_2026!#

# Cryptographic OTP challenge hash key for Staging (different from Production)
STAGING_OTP_HASH_KEY=ReplaceWithStagingOtpHashKey_Minimum32Chars_Secure!#

# Staging HTTP Basic Authentication Credentials (for Nginx access control)
STAGING_BASIC_AUTH_USER=terma_tester
STAGING_BASIC_AUTH_PASSWORD=ReplaceWithStrongStagingBasicAuthPass123!

# ZarinPal Payment Gateway (Sandbox for Staging)
STAGING_ZARINPAL_IS_SANDBOX=true
STAGING_ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
