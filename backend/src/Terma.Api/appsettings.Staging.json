{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "EnvironmentName": "Staging",
  "Database": {
    "AutoMigrate": false
  },
  "MediaStorage": {
    "RootPath": "media"
  },
  "DataProtection": {
    "KeyPath": "/app/dataprotection-keys"
  },
  "Otp": {
    "ExposeDevelopmentCode": false
  },
  "SmsIr": {
    "Enabled": false,
    "TemplateId": 0,
    "ParameterName": "Code"
  },
  "Telegram": {
    "Enabled": false
  },
  "EnableSwagger": true,
  "Security": {
    "RequireSecureCookies": true,
    "EnforceHttps": true
  }
}
